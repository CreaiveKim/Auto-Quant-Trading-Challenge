# AI Quant Trading System - Environment Variables
# Copy this file to .env and fill private values locally.

# Oracle Cloud deployment notes.
# These variables are informational for operators; the app does not call OCI APIs.
CLOUD_PROVIDER=oracle
ORACLE_HOME_REGION=ap-seoul-1
ORACLE_SHAPE=VM.Standard.A1.Flex
ORACLE_OCPU=2
ORACLE_MEMORY_GB=12

# Telegram Bot Configuration
# Never commit real Telegram tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL=

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Model Configuration
MODEL_FILE=Low_conf.pkl

# Trading Configuration
BASE_THRESHOLD=0.60
TAKE_PROFIT=0.02
STOP_LOSS=-0.03
MAX_HOLD_MINUTES=30
SWITCH_MIN_CONFIDENCE_DELTA=0.0
INITIAL_CAPITAL=5000000
PAPER_TRADING_ENABLED=True
SIMULATION_INTERVAL_SECONDS=60
FEE_BPS=5

# Optional comma-separated market override.
# Example: MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
MARKETS=

# Risk Management
RISK_PROFILE=neutral

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7

# Performance
CONCURRENT_MARKETS=5
MEMORY_LIMIT_MB=4096
